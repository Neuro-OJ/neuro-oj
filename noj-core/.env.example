# ⚠️  noj-core 环境配置 ⚠️
# ============================================================
# 复制此文件为 .env 并根据实际环境修改：
#     cp noj-core/.env.example noj-core/.env
#
# 重要安全提醒：
#   1. .env 中所有值仅用于本地开发；生产环境必须使用 secrets manager 注入。
#   2. JWT_SECRET 必须是 ≥32 字符的随机串（HS256 算法要求）。
#      留空或使用占位符会导致 main.ts 启动时硬拒绝（exit 1）。
#   3. 本文件所有占位值（change-this-...、changeme、example、test）
#      都会被 `deno task check:env` 脚本主动拦截，防止误用于生产。
# ============================================================
DATABASE_URL=postgres://noj:noj@localhost:5432/noj
JWT_SECRET=change-this-to-a-strong-random-secret
JWT_EXPIRES_IN=24h
REDIS_URL=redis://127.0.0.1:6379/
PORT=8000

# ── 日志 ────────────────────────────────────────────────────
# 日志级别：debug / info / warn / error。
# 未设置时按环境回退：NOJ_ENV=production 默认 info，否则 debug。
# LOG_LEVEL=info
# 输出格式：json（结构化，便于日志聚合）/ pretty（人类可读）。
# 未设置时按环境回退：production 默认 json，否则 pretty。
# LOG_FORMAT=pretty

# ⚡ 强烈推荐设置：运行 deno task dev-setup 时自动创建/提升管理员。
# 未设置时 bootstrap:admin 会创建临时引导管理员（终端打印随机密码，首次登录必须改密）。
ADMIN_EMAIL=
# 管理员密码（需要与 ADMIN_EMAIL 配合使用；未设置但 ADMIN_EMAIL 对应已注册用户时仅提权）
ADMIN_PASS=

# ── 速率限制（issue #73 登录限流）──────────────────────────
# 总开关：true=启用 / false=禁用。NOJ_ENV=test 时强制关闭
RATE_LIMIT_ENABLED=true
# IP 维度：30 秒窗口内最多 10 次登录尝试（防单 IP 暴力破解）
RATE_LIMIT_LOGIN_IP_WINDOW=30
RATE_LIMIT_LOGIN_IP_MAX=10
# 账号维度：30 秒窗口内最多 5 次登录尝试（防分布式撞同一账号）
RATE_LIMIT_LOGIN_ACC_WINDOW=30
RATE_LIMIT_LOGIN_ACC_MAX=5
# 失败退避：每次失败累计 +15s 等待（下一次请求被 sleep 拦下）
RATE_LIMIT_LOGIN_BACKOFF_SEC=15
# 失败锁定：连续 10 次失败后账号锁 1 小时
RATE_LIMIT_LOGIN_LOCK_THRESHOLD=10
RATE_LIMIT_LOGIN_LOCK_SECONDS=3600
# 可信代理白名单（逗号分隔 IP/CIDR）。配置后从 XFF 链中提取客户端 IP；
# 留空则开发模式直接信任 XFF 首项。生产环境**必须**配置。
TRUSTED_PROXIES=

# ---- 邮件发送 Provider ----
# EMAIL_PROVIDER=mock | aliyun | tencent
# 不设置或设为 mock 时，邮件仅输出到控制台
EMAIL_PROVIDER=mock

# 阿里云 DirectMail（EMAIL_PROVIDER=aliyun 时必填）
# 发信地址需要先在阿里云控制台验证域名
ALIBABA_ACCESS_KEY_ID=
ALIBABA_ACCESS_KEY_SECRET=
ALIBABA_FROM_EMAIL=

# 腾讯云 SES（EMAIL_PROVIDER=tencent 时必填）
# 发信地址需要先在腾讯云 SES 控制台验证域名
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_FROM_EMAIL=
TENCENT_REGION=ap-guangzhou

# ── 对象存储 ──────────────────────────────────────────
# 存储 Provider：local（开发测试用）或 s3（生产环境）
STORAGE_PROVIDER=local
# S3 兼容对象存储配置（STORAGE_PROVIDER=s3 时必填）
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=noj-support-packages
S3_FORCE_PATH_STYLE=true

# ── 系统设置（issue #99）─────────────────────────────────
# 以下 5 项可在「管理后台 > 系统设置」运行时修改，env 值仅作启动期 fallback。
# 修改 .env 后必须重启 noj-core 才生效；管理后台修改即时生效。

# ALLOW_REGISTER=true  # 是否开放新用户注册（关闭后 register API 返回 403）
# SMTP_FROM=  # 系统发件人地址（邮件 Provider 通用）
# RATE_LIMIT_LOGIN_ENABLED=true  # 是否启用登录速率限制（NOJ_ENV=test 时强制关闭）
# MAINTENANCE_MODE=false  # 维护模式（启用后写操作 API 返回 503）
# HOMEPAGE_BANNER=  # 首页顶部公告（最多 1000 字符）

# ---- 审计日志（issue #101）----
# 审计日志保留天数。0 = 禁用自动清理（需手动维护）
AUDIT_LOG_RETENTION_DAYS=90

# ── 社区设置（add-community-system）──────────────────────
# 以下各项可在「管理后台 > 社区管理」运行时修改，env 值仅作启动期 fallback。
# 社区总开关（false 时社区 API 全部返回 FEATURE_DISABLED）
# COMMUNITY_ENABLED=true
# 是否允许游客阅读社区公开内容
# COMMUNITY_GUEST_READ_ENABLED=false
# 社区只读模式（审核员与管理员除外）
# COMMUNITY_READ_ONLY=false
# 各模块开关：题解 / 讨论 / 短动态 / 系统活动 / 评论 / 点赞 / 收藏 / 关注
# COMMUNITY_SOLUTIONS_ENABLED=true
# COMMUNITY_DISCUSSIONS_ENABLED=true
# COMMUNITY_MOMENTS_ENABLED=true
# COMMUNITY_ACTIVITIES_ENABLED=true
# COMMUNITY_COMMENTS_ENABLED=true
# COMMUNITY_REACTIONS_ENABLED=true
# COMMUNITY_BOOKMARKS_ENABLED=true
# COMMUNITY_FOLLOWS_ENABLED=true
# 站内私信开关（归入社区分类）
# PRIVATE_MESSAGING_ENABLED=true
# 是否允许 Markdown 渲染 HTTPS 外链图片
# COMMUNITY_EXTERNAL_IMAGES_ENABLED=false
# 发布题解是否必须先通过对应题目
# COMMUNITY_SOLUTION_REQUIRES_ACCEPTED=true
# 注册不足指定小时的用户发布内容需审核（0 为关闭）
# COMMUNITY_NEW_USER_REVIEW_HOURS=0
# 内容长度上限：题解/讨论正文、短动态、评论（字符）
# COMMUNITY_POST_MAX_LENGTH=20000
# COMMUNITY_MOMENT_MAX_LENGTH=1000
# COMMUNITY_COMMENT_MAX_LENGTH=10000
# 用户发布内容最小间隔秒数（0 为不限制）
# COMMUNITY_POST_INTERVAL_SECONDS=0
