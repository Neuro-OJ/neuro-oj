# 本地前端代理的后端地址。
NUXT_API_BASE=http://localhost:8000
# 同一主机多套 UI 各自使用不同值；普通单套部署保持 noj。
NUXT_PUBLIC_AUTH_COOKIE_PREFIX=noj
# 前端功能开关：是否显示「我的学习」及知识追踪/知识图谱相关页面与入口（true / false）。
NUXT_PUBLIC_KNOWLEDGE_ENABLED=false

# 可选：BFF 公共元信息短缓存；连接故障时自动绕过。不同部署共享 Redis 时使用独立前缀。
NUXT_BFF_REDIS_URL=
NUXT_BFF_CACHE_PREFIX=noj:ui:bff:v1
