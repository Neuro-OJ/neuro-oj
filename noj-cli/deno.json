{
  "version": "0.11.0",
  "tasks": {
    "test": "deno test -A",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno fmt --check && deno lint && deno check src/",
    "build:cli": "deno compile -A --frozen --target x86_64-unknown-linux-gnu --output bin/noj-cli-linux-amd64 src/cli.ts",
    "test:production": "deno test -A src/prod/"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@std/path": "jsr:@std/path@^1",
    "fflate": "npm:fflate@~0.8.3",
    "yaml": "npm:yaml@^2.9.1"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "fmt": {
    "semiColons": true,
    "singleQuote": false,
    "indentWidth": 2
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
