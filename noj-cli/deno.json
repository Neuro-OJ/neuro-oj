{
  "name": "@noj/cli",
  "version": "0.10.0",
  "exports": "./src/mod.ts",
  "tasks": {
    "test": "deno test -A",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno fmt --check && deno lint && deno check src/mod.ts src/cli.ts",
    "build:cli": "deno compile -A --frozen --target x86_64-unknown-linux-gnu --output bin/noj-cli-linux-amd64 src/cli.ts",
    "test:production": "bash ../scripts/deploy/test-deprecation-gate.sh && deno test -A src/prod/"
  },
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@1.2.1",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/path": "jsr:@std/path@^1",
    "fflate": "npm:fflate@~0.8.3"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "fmt": {
    "semiColons": true,
    "singleQuote": false,
    "indentWidth": 2
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
