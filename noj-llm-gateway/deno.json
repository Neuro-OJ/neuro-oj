{
  "name": "@noj/llm-gateway",
  "version": "0.1.0",
  "exports": "./src/mod.ts",
  "tasks": {
    "dev": "deno run --watch --env-file=.env -A src/main.ts",
    "start": "deno run --env-file=.env -A src/main.ts",
    "test": "deno test -A --no-check",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno fmt --check && deno lint && deno check src/mod.ts"
  },
  "imports": {
    "hono": "npm:hono@^4",
    "hono/": "npm:/hono@^4/",
    "ioredis": "npm:ioredis@5.11.1",
    "postgres": "npm:postgres@3.4.5",
    "@std/encoding": "jsr:@std/encoding@^1"
  },
  "nodeModulesDir": "auto",
  "fmt": {
    "semiColons": true,
    "singleQuote": false,
    "indentWidth": 2
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  }
}
