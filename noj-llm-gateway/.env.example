# noj-llm-gateway 环境变量模板
# 复制为 .env 后修改，禁止使用占位符启动生产环境。
#   cp .env.example .env

# PostgreSQL 连接串（与 noj-core 使用同一实例）
DATABASE_URL=postgres://noj:noj@localhost:5432/noj

# Redis 连接串
REDIS_URL=redis://127.0.0.1:6379/0

# core 共享密钥：服务间鉴权 + AEAD eval_token 签发/校验（≥16 字符）
NOJ_LLM_SERVICE_TOKEN=change-this-to-a-strong-llm-service-token

# 信封加密主密钥：用于加密/解密 llm_providers.encrypted_api_key（≥16 字符）
NOJ_LLM_STORE_KEY=change-this-to-a-strong-llm-store-key

# 用户 BYOK Provider 允许的 HTTPS 主机（逗号分隔；默认仅 api.openai.com）
NOJ_LLM_BYOK_ALLOWED_HOSTS=api.openai.com

# 监听端口（可选，默认 8001）
# NOJ_LLM_PORT=8001

# LLM 配额缺失时的安全 fallback（与 gateway 启动 seed 默认值一致，可按需调整）
# 由 noj-llm-gateway 消费（不是 noj-core）；改动后需重启 llm-gateway。
# 命名规则：NOJ_LLM_DEFAULT_<SCOPE>_<WINDOW>_<FIELD>
#   SCOPE  = GLOBAL | USER | PROBLEM
#   WINDOW = DAY | MONTH
#   FIELD  = CALLS | TOKENS | COST
# 共 18 个。仅当 llm_quotas 表无对应记录时才作为兜底生效。
# --- day 窗口 ---
# NOJ_LLM_DEFAULT_GLOBAL_DAY_CALLS=10000
# NOJ_LLM_DEFAULT_GLOBAL_DAY_TOKENS=1000000
# NOJ_LLM_DEFAULT_GLOBAL_DAY_COST=1000
# NOJ_LLM_DEFAULT_USER_DAY_CALLS=1000
# NOJ_LLM_DEFAULT_USER_DAY_TOKENS=100000
# NOJ_LLM_DEFAULT_USER_DAY_COST=100
# NOJ_LLM_DEFAULT_PROBLEM_DAY_CALLS=5000
# NOJ_LLM_DEFAULT_PROBLEM_DAY_TOKENS=500000
# NOJ_LLM_DEFAULT_PROBLEM_DAY_COST=500
# --- month 窗口 ---
# NOJ_LLM_DEFAULT_GLOBAL_MONTH_CALLS=100000
# NOJ_LLM_DEFAULT_GLOBAL_MONTH_TOKENS=10000000
# NOJ_LLM_DEFAULT_GLOBAL_MONTH_COST=10000
# NOJ_LLM_DEFAULT_USER_MONTH_CALLS=10000
# NOJ_LLM_DEFAULT_USER_MONTH_TOKENS=1000000
# NOJ_LLM_DEFAULT_USER_MONTH_COST=1000
# NOJ_LLM_DEFAULT_PROBLEM_MONTH_CALLS=50000
# NOJ_LLM_DEFAULT_PROBLEM_MONTH_TOKENS=5000000
# NOJ_LLM_DEFAULT_PROBLEM_MONTH_COST=5000
# 用户/IP 每个 UTC 分钟窗口的调用次数（可选，默认均为 60，必须为正整数）
# NOJ_LLM_USER_RATE_LIMIT_PER_MINUTE=60
# NOJ_LLM_IP_RATE_LIMIT_PER_MINUTE=60

# ── 日志 ──────────────────────────────────────────────────────────────
# 运行环境标记：production 时启用 JSON 输出与生产脱敏（截断 *_id、抹除
# password/token/api_key 等、隐藏 score）。未设置按开发模式渲染——
# 彩色 pretty 且不脱敏，生产部署务必设为 production。
# NOJ_ENV=production
# 日志级别：debug / info / warn / error。未设置时 production 回退 warn，否则 debug。
# LOG_LEVEL=info
# 输出格式：json（结构化，便于日志聚合）/ pretty（人类可读）。
# 未设置时 production 回退 json，否则 pretty。
# LOG_FORMAT=json
# 终端着色：always / never / auto（默认 auto，按 stdout/stderr 分别探测 TTY）。
# 判定顺序：NO_COLOR（非空即关）→ LOG_COLOR=never → LOG_COLOR=always → auto。
# LOG_FORMAT=json 时恒无色并忽略本项（避免 ANSI 转义写进结构化日志流）。
# LOG_COLOR=auto
# 通用配色禁用约定（https://no-color.org）：非空即关闭着色并优先于 LOG_COLOR。
# 容器/CI 建议设置，避免转义码写入日志文件。
# NO_COLOR=1
