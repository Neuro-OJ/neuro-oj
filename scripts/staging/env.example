# staging 验收专用变量。请复制到安全位置后填写，不要提交真实凭据。
# 该文件由 acceptance.sh 通过 --env-file 传给 Docker Compose。

NOJ_VERSION=staging-candidate
POSTGRES_USER=noj
POSTGRES_PASSWORD=替换为随机长密码
POSTGRES_DB=noj
REDIS_PASSWORD=替换为随机长密码
JWT_SECRET=至少32字符的随机值
TFA_ENCRYPTION_KEY=至少32字符的随机值
NOJ_LLM_SERVICE_TOKEN=替换为随机服务令牌
NOJ_LLM_STORE_KEY=替换为随机存储密钥
APP_URL=https://staging.example.com
CORS_ALLOWED_ORIGINS=https://staging.example.com
TRUSTED_PROXIES=172.16.0.0/12
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=替换为对象存储访问密钥
S3_SECRET_KEY=替换为对象存储秘密密钥
S3_BUCKET=noj-staging
EMAIL_PROVIDER=mock
ADMIN_EMAIL=admin@example.com
ADMIN_PASS=替换为强密码
JUDGE_DOCKER_SOCKET=/var/lib/noj-judge/docker.sock
JUDGE_DOCKER_SOCKET_GID=1000

# acceptance.sh 在宿主机上调用边缘入口时使用的变量。
STAGING_BASE_URL=https://staging.example.com
STAGING_CORS_ORIGIN=https://staging.example.com
STAGING_ADMIN_EMAIL=admin@example.com
STAGING_ADMIN_PASSWORD=替换为与 ADMIN_PASS 相同的强密码
