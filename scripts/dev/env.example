# Neuro OJ 核心服务 (noj-core) 环境变量模板
# ⚠️  仅限本地开发模板；生产环境必须通过 secrets manager 注入真实凭据。
# 复制本文件后请立即修改 JWT_SECRET 与 ADMIN_* 占位值。
# 使用方法: cp scripts/dev/env.example noj-core/.env

# ── 数据库连接 ───────────────────────────────────────────────
# PostgreSQL 连接字符串(postgres.js 格式)
DATABASE_URL=postgresql://noj:noj@localhost:5432/noj

# ── JWT 密钥(必填,至少 32 字符) ──────────────────────────────
# 启动时会校验长度,不足则 Deno.exit(1) 拒绝启动
# 生成方法: openssl rand -base64 48
JWT_SECRET=change-this-to-a-strong-random-secret

# ── JWT 配置(可选) ───────────────────────────────────────────
# JWT_EXPIRES_IN=24h
# JWT_ISSUER=nj-core
# JWT_AUDIENCE=nj-ui

# ── 服务监听端口(可选) ───────────────────────────────────────
# PORT=8000

# ── Redis 连接(可选,默认 localhost:6379) ────────────────────
# REDIS_URL=redis://localhost:6379

# ── 存储后端 ──────────────────────────────────────────────────
# local 模式(默认,开发环境)
# STORAGE_PROVIDER=local
# SUPPORT_PACKAGE_DIR=./data/storage

# s3 模式(生产环境)
# STORAGE_PROVIDER=s3
# S3_BUCKET=noj-support-packages
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...

# ── 运行环境 ──────────────────────────────────────────────────
# development | production
# NOJ_ENV=development

# ── 审计日志保留天数(可选,0 = 禁用) ─────────────────────────
# AUDIT_LOG_RETENTION_DAYS=90

# ── 引导管理员(首次部署强烈推荐设置) ─────────────────────────
# 若不设置,seed 时会自动生成临时管理员(密码 24 字符随机),
# 登录后强制跳转 /change-password 修改
ADMIN_EMAIL=change-me-admin@example.com
ADMIN_PASS=change-me-password-123

# 引导管理员是否强制首次改密（issue #75 守卫，默认 true）。
# 使用 `devtool.sh bootstrap admin` 创建管理员时自动设为 false（开发环境）。
# NOJ_FORCE_PASSWORD_CHANGE=false

# ── 社区设置(add-community-system, 可选) ────────────────────
# 以下各项可在「管理后台 > 社区管理」运行时修改,env 值仅作启动期 fallback
# COMMUNITY_ENABLED=true
# COMMUNITY_GUEST_READ_ENABLED=false
# COMMUNITY_READ_ONLY=false
# COMMUNITY_SOLUTIONS_ENABLED=true
# COMMUNITY_DISCUSSIONS_ENABLED=true
# COMMUNITY_MOMENTS_ENABLED=true
# COMMUNITY_ACTIVITIES_ENABLED=true
# COMMUNITY_COMMENTS_ENABLED=true
# COMMUNITY_REACTIONS_ENABLED=true
# COMMUNITY_BOOKMARKS_ENABLED=true
# COMMUNITY_FOLLOWS_ENABLED=true
# PRIVATE_MESSAGING_ENABLED=true
# COMMUNITY_EXTERNAL_IMAGES_ENABLED=false
# COMMUNITY_SOLUTION_REQUIRES_ACCEPTED=true
# COMMUNITY_NEW_USER_REVIEW_HOURS=0
# COMMUNITY_POST_MAX_LENGTH=20000
# COMMUNITY_MOMENT_MAX_LENGTH=1000
# COMMUNITY_COMMENT_MAX_LENGTH=10000
# COMMUNITY_POST_INTERVAL_SECONDS=0

# ── 评测资源全局上限(可选,0 = 不限制;DB 设置优先,env 仅兜底) ──
# JUDGE_MAX_EVALUATOR_TIME_LIMIT_MS=0
# JUDGE_MAX_EVALUATOR_MEMORY_LIMIT_MB=0
# JUDGE_MAX_SOLUTION_CALL_TIMEOUT_MS=0
# JUDGE_MAX_SOLUTION_MEMORY_LIMIT_MB=0
