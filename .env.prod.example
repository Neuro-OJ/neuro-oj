# Neuro OJ 公测生产环境配置模板
# 复制为 .env.prod 后填写真实值，禁止使用占位符启动。
#
#   cp .env.prod.example .env.prod
#   vim .env.prod
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
#
# ⚠️ 推荐路径：使用 `bash scripts/deploy/deploy.sh install` 自动安装。
#    它会从本模板生成 .env.prod，**自动生成全部强随机密钥**
#    （JWT_SECRET / TFA_ENCRYPTION_KEY / 数据库口令 / S3 / LLM 密钥），
#    并拒绝占位值。手动复制本模板时必须自行生成密钥，否则部署无法启动。
#
# 密钥生成命令：openssl rand -base64 48

# ── 版本与域名 ─────────────────────────────────────────────────────
# ghcr.io 镜像版本标签（必须使用已发布的不可变 Release tag）
NOJ_VERSION=change-me-release-tag
# 默认关闭镜像签名校验，降低一键部署门槛；需要严格校验时改为 true 并安装 Cosign
NOJ_ENFORCE_IMAGE_SIGNATURES=false
# Cosign 证书身份正则；默认只信任本仓库的 Release workflow
NOJ_COSIGN_CERT_IDENTITY_REGEX=^https://github.com/Neuro-OJ/neuro-oj/.github/workflows/release.yml@.*$
# 对外域名（不含协议）
DOMAIN=change-me.example.com
# 容器 Nginx 映射到宿主机的端口；同机外部 TLS 终止建议 8080，云 LB 直连可设 80
NGINX_PORT=8080
# 前端环境标记：生产环境保持 production
NUXT_NOJ_ENV=production
# 完整应用地址
APP_URL=https://change-me.example.com
# 可选第三方登录；每个 provider 的配置必须完整填写才会启用
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_OIDC_ISSUER_URL=
OAUTH_OIDC_CLIENT_ID=
OAUTH_OIDC_CLIENT_SECRET=
OAUTH_OIDC_NAME=OIDC
# 是否允许临时 HTTP（默认关闭；仅在明确测试时设为 true）
NOJ_ALLOW_INSECURE_HTTP=false
# CORS 白名单（逗号分隔）
CORS_ALLOWED_ORIGINS=https://change-me.example.com
# 可信代理网段：必须与 docker-compose.prod.yml 中 noj-net 子网一致
TRUSTED_PROXIES=172.28.0.0/16

# ── PostgreSQL ─────────────────────────────────────────────────────
POSTGRES_USER=noj
POSTGRES_PASSWORD=change-me-strong-postgres-password
POSTGRES_DB=noj

# ── Redis ──────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-strong-redis-password

# ── MinIO / S3 ─────────────────────────────────────────────────────
# 自建 MinIO 管理员账号，仅供 minio-init 使用，不得注入 core
MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-strong-minio-password
# core 使用独立的 bucket-scoped 应用凭据
S3_ACCESS_KEY=change-me-noj-storage-user
S3_SECRET_KEY=change-me-strong-noj-storage-password
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET=noj-support-packages
S3_REGION=us-east-1

# ── 认证密钥（必填，必须 ≥32 字符随机串）──────────────────────────
# 这里刻意留空：占位值长度可能"恰好"达到 32 字符而被长度校验放行
# （原模板的 change-me-to-a-random-string-at-least-32-chars 就是 46 字符），
# 会导致以公开已知密钥上线。留空则 compose 的 ${VAR:?} 与 noj-core 启动校验
# 都会立即拒绝，强制部署者生成真实密钥。
#   JWT_SECRET:          openssl rand -base64 48
#   TFA_ENCRYPTION_KEY:  openssl rand -base64 48（必须与 JWT_SECRET 不同）
JWT_SECRET=
TFA_ENCRYPTION_KEY=
# noj-llm-gateway 服务间鉴权 + AEAD eval_token 签发/校验密钥（必填，≥16 字符）
NOJ_LLM_SERVICE_TOKEN=
# noj-llm-gateway 加密上游 Provider API Key 的信封加密主密钥（必填，≥16 字符）
NOJ_LLM_STORE_KEY=
# 用户 BYOK 允许的 HTTPS Provider 主机（逗号分隔，默认仅 api.openai.com）
NOJ_LLM_BYOK_ALLOWED_HOSTS=api.openai.com
# 使用 LLM 调用题时必须开启 evaluator 联网，并让 evaluator 加入 gateway 所在网络
JUDGE_ALLOW_EVALUATOR_NETWORK=true
JUDGE_EVALUATOR_NETWORK=noj-net
# 单次评测 eval_token 的调用/token 上限（可选，默认 100/50000）
# NOJ_LLM_MAX_CALLS=100
# NOJ_LLM_MAX_TOKENS=50000
# LLM 配额缺失时的安全 fallback（与 noj-llm-gateway 启动 seed 默认值一致，可按需调整）
# 由 noj-llm-gateway 消费（不是 noj-core）；改动后需重启 llm-gateway。
# 命名规则：NOJ_LLM_DEFAULT_<SCOPE>_<WINDOW>_<FIELD>
#   SCOPE  = GLOBAL | USER | PROBLEM
#   WINDOW = DAY | MONTH
#   FIELD  = CALLS | TOKENS | COST
# 共 18 个。仅当 llm_quotas 表无对应记录时才作为兜底生效。
# --- day 窗口 ---
# NOJ_LLM_DEFAULT_GLOBAL_DAY_CALLS=10000
# NOJ_LLM_DEFAULT_GLOBAL_DAY_TOKENS=1000000
# NOJ_LLM_DEFAULT_GLOBAL_DAY_COST=1000
# NOJ_LLM_DEFAULT_USER_DAY_CALLS=1000
# NOJ_LLM_DEFAULT_USER_DAY_TOKENS=100000
# NOJ_LLM_DEFAULT_USER_DAY_COST=100
# NOJ_LLM_DEFAULT_PROBLEM_DAY_CALLS=5000
# NOJ_LLM_DEFAULT_PROBLEM_DAY_TOKENS=500000
# NOJ_LLM_DEFAULT_PROBLEM_DAY_COST=500
# --- month 窗口 ---
# NOJ_LLM_DEFAULT_GLOBAL_MONTH_CALLS=100000
# NOJ_LLM_DEFAULT_GLOBAL_MONTH_TOKENS=10000000
# NOJ_LLM_DEFAULT_GLOBAL_MONTH_COST=10000
# NOJ_LLM_DEFAULT_USER_MONTH_CALLS=10000
# NOJ_LLM_DEFAULT_USER_MONTH_TOKENS=1000000
# NOJ_LLM_DEFAULT_USER_MONTH_COST=1000
# NOJ_LLM_DEFAULT_PROBLEM_MONTH_CALLS=50000
# NOJ_LLM_DEFAULT_PROBLEM_MONTH_TOKENS=5000000
# NOJ_LLM_DEFAULT_PROBLEM_MONTH_COST=5000
# LLM 网关用户/IP 每个 UTC 分钟窗口的调用次数（可选，默认均为 60，必须为正整数）
# NOJ_LLM_USER_RATE_LIMIT_PER_MINUTE=60
# NOJ_LLM_IP_RATE_LIMIT_PER_MINUTE=60
JWT_EXPIRES_IN=24h

# ── 邮件 Provider ──────────────────────────────────────────────────
# aliyun | tencent（生产禁止 mock）
# 邮件服务：disabled（暂不配置）/ aliyun（阿里云）/ tencent（腾讯云）
EMAIL_PROVIDER=disabled
ALIBABA_ACCESS_KEY_ID=change-me-alibaba-access-key-id
ALIBABA_ACCESS_KEY_SECRET=change-me-alibaba-access-key-secret
ALIBABA_FROM_EMAIL=change-me-sender@example.com
# 使用腾讯云时填写以下字段，并清空不使用的阿里云字段
TENCENT_SECRET_ID=change-me-tencent-secret-id
TENCENT_SECRET_KEY=change-me-tencent-secret-key
TENCENT_FROM_EMAIL=change-me-sender@example.com
TENCENT_REGION=ap-guangzhou

# ── 评测镜像仓库前缀 ───────────────────────────────────────────────
# 初始化 judge_images 白名单时使用 ghcr 全限定镜像名
JUDGE_IMAGE_BASE=ghcr.io/neuro-oj/

# ── Judge Worker ───────────────────────────────────────────────────
# 首次安装时会询问是否部署 Judge；false 可先跳过，后续补充 socket 后改为 true
JUDGE_ENABLED=true
# 评测任务队列名前缀，实际使用 {prefix}:high / :medium / :low
JUDGE_QUEUE=noj:judge:queue
RESULT_QUEUE=noj:judge:results
# 优先级轮询时每个队列 BRPOPLPUSH 超时（毫秒）
JUDGE_PRIORITY_POLL_TIMEOUT_MS=100
WORK_DIR=/tmp/noj-judge
JUDGE_MAX_CONCURRENT_JUDGES=2
JUDGE_CPU_LIMIT_MILLICORES=1000
# judge 侧资源硬上限（毫秒），防止异常任务长时间占用评测槽
JUDGE_MAX_EVALUATOR_TIME_MS=300000
JUDGE_MAX_SOLUTION_CALL_TIMEOUT_MS=60000
JUDGE_IMAGE_PREFIX=noj-
JUDGE_COMMAND_WHITELIST=python3,deno,node,bash,sh
JUDGE_ALLOW_EVALUATOR_NETWORK=false
# 自建 MinIO 内网为 HTTP 时设为 true，允许 judge 通过 HTTP 下载支持包
JUDGE_ALLOW_HTTP_S3=true
# 独立 rootless Docker daemon 的 Unix socket（禁止填写 /var/run/docker.sock）
JUDGE_DOCKER_SOCKET=/run/noj-judge/docker.sock
JUDGE_DOCKER_SOCKET_GID=10001
# noj-judge 容器内的非 root 用户；需与 socket 权限策略匹配
JUDGE_UID=10001
JUDGE_GID=10001
JUDGE_DOCKER_HOST=unix:///run/noj-judge/docker.sock
JUDGE_REQUIRE_ISOLATED_DOCKER=true
SUPPORT_PACKAGE_DOWNLOAD_TIMEOUT=60
SUPPORT_CACHE_DIR=/tmp/noj-judge/support-cache
SUPPORT_CACHE_MAX_ITEMS=500
SUPPORT_CACHE_MAX_MB=2048

# ── 日志 ────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

# ── 可观测性 ────────────────────────────────────────────────────────
# 推荐用内置的可选 profile 一键获得采集与告警（2026-09-12 评审 §5.3）：
#     docker compose --env-file .env.prod -f docker-compose.prod.yml --profile monitoring up -d
# 启动前需把 deploy/monitoring/alertmanager.yml.example 复制为
# deploy/monitoring/alertmanager.yml 并填入接收器（否则 alertmanager 会 fail-fast）。
# 也可按 deploy/monitoring/README.md 手工在宿主机运行（下面的键供该场景使用）。
#
# Prometheus 在 noj-net 内部抓取 core:8000/metrics 与 llm-gateway:8001/metrics；
# 不要将这些端口直接映射到公网（profile 默认只绑 127.0.0.1）。
# Judge Worker 心跳通过 Redis 聚合，JUDGE_ENABLED=false 时不对缺少 Judge 的环境告警。
# OBSERVABILITY_SNAPSHOT_TIMEOUT_MS=500
# OBSERVABILITY_CACHE_TTL_MS=1000
# OBSERVABILITY_MAX_SERIES=1000
#
# 注意两个网关地址**用途不同**（评审 §5.3 已核实，不是重复键）：
#   NOJ_LLM_GATEWAY_URL     = 出站 LLM 调用地址，注入 evaluator 环境（compose 已固定设置）
#   RUNTIME_LLM_GATEWAY_URL = 内部健康/指标探测地址，供 observability runtime-contract 使用
# 默认值写的是开发编排的 container_name（noj-llm-gateway），生产服务名是 llm-gateway，
# compose 已显式设置为 http://llm-gateway:8001；手工部署时同样必须写对。
# RUNTIME_LLM_GATEWAY_URL=http://llm-gateway:8001
# RUNTIME_JUDGE_MODE=heartbeat
# 监控 profile 资源与端口（均有默认值，按机器规格调整）
# PROMETHEUS_MEM_LIMIT=1g
# PROMETHEUS_RETENTION=15d
# PROMETHEUS_BIND=127.0.0.1
# PROMETHEUS_PORT=9090
# ALERTMANAGER_MEM_LIMIT=256m
# ALERTMANAGER_BIND=127.0.0.1
# ALERTMANAGER_PORT=9093

# ── 前端与各服务资源上限（2026-09-12 评审 §5.2）────────────────────
# 一键安装曾完全没有任何资源上限与日志轮转：单机部署最常见、最致命的两类故障
# （OOM 杀掉 postgres、日志打满磁盘导致全站写入失败）都没有防线。
# compose 现在为每个服务设置了默认 mem_limit 与 json-file 日志轮转（50m × 5），
# 下列变量用于按机器规格覆盖。
# NUXT_SITE_URL=https://noj.example.com   # sitemap/canonical 的权威地址（必须配置，见 §4.2）
# CORE_MEM_LIMIT=1g
# UI_MEM_LIMIT=1g
# JUDGE_MEM_LIMIT=2g
# LLM_GATEWAY_MEM_LIMIT=512m
# NGINX_MEM_LIMIT=256m
# POSTGRES_MEM_LIMIT=2g
# REDIS_MEM_LIMIT=1g
# MINIO_MEM_LIMIT=1g
# MIGRATE_MEM_LIMIT=1g
# MINIO_INIT_MEM_LIMIT=256m

# ── 可选配置 ───────────────────────────────────────────────────────
# RATE_LIMIT_ENABLED=true
# AUDIT_LOG_RETENTION_DAYS=90

# ── 生产备份（宿主机配置，不会注入 Compose） ─────────────────────────
# 口令文件必须存放在仓库外，权限为 600 或 400；建议通过 systemd/cron 的环境注入。
# NOJ_BACKUP_PASSPHRASE_FILE=/etc/noj/backup-passphrase
# NOJ_BACKUP_RETENTION_DAYS=30
# NOJ_BACKUP_MIN_FREE_MB=1024
# PostgreSQL 快照为完整逻辑备份；更低 RPO 需要额外配置 WAL/PITR 归档。
