/backups/

# --- Staging 验收产物 ---
/artifacts/staging/

# --- AI 工具本地配置（AGENTS.md §7.1：不提交 AI 工具配置） ---
.commandcode/

# --- Jujutsu (jj) ---
.jj/repo/op_heads/
.jj/repo/store/

# --- AI tool migration artifacts ---
# `source-command-opsx-*` 是 opsx 命令的 source-command 包装 wrapper，
# 与 `.agents/skills/openspec-*` 功能重复，迁移完成后应删除；
# 在清理完成前临时忽略，防止误提交。
.agents/skills/source-command-opsx-*/

# --- Build Artifacts ---
tmp/
coverage/
*.wasm

# --- noj-server / noj-cli 构建产物 ---
noj-core/bin/
noj-cli/bin/

# --- Problem Data (noj-core) ---
# Support packages are build artifacts, not versioned
noj-core/data/packages/
!noj-core/data/packages/.gitkeep
# Local storage backend (problem-bundle-import: separated from build artifacts)
noj-core/data/storage/

# --- IDE metadata (project-local, not shareable) ---
*.iml
*.idea/
.playwright-mcp/
aa.txt

# --- Rust profiling ---
*.profraw
*.profdata

# --- Docker buildx cache ---
.buildx/

.reasonix/docs/review-snapshots/
dev-docs/review-snapshots/
.reasonix/

