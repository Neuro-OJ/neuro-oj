# E2E 测试环境变量配置模板
# 复制为 .env，或直接用会话启动完整环境：
#   deno run -A scripts/e2e/session.ts up --session <name> [--ui]
#   deno run -A scripts/e2e/session.ts env --session <name>
#   deno run -A scripts/e2e/session.ts down --session <name>
#
# 本地会话会用自己的清单覆盖下面的端口/网络/URL；本文件提供的是 **CI 默认值**
#（固定端口 + noj-eval-net），保证 CI 不依赖会话管理器也能跑。

# ---------- E2E 主机端口（会话覆盖；CI 用这些默认值）----------
# 端口与 docker-compose.e2e.yml 的 ${E2E_*_PORT:-默认} 一一对应。
E2E_PG_PORT=5433
E2E_REDIS_PORT=6380
E2E_CORE_PORT=8099
E2E_MINIO_PORT=9002
E2E_MINIO_CONSOLE_PORT=9001
E2E_LLM_GATEWAY_PORT=8003
E2E_LLM_MOCK_PORT=8002
E2E_TEST_COORDINATOR_PORT=18010
# evaluator 网络：本地会话为 noj-e2e-<run>-evaluator，CI 固定 noj-eval-net。
E2E_EVALUATOR_NETWORK=noj-eval-net

# ---------- noj-core ----------
DATABASE_URL=postgres://e2e:e2e@localhost:5433/e2e
REDIS_URL=redis://localhost:6380/1
# JWT_SECRET 单一来源（修复 finding S1），与 e2e.yml workflow env、
# docker-compose.e2e.yml noj-core service 完全一致；长度 ≥32 满足 noj-core
# main.ts 的强校验。原 e2e-test-secret 仅 15 字符，会被 main.ts 拒启动。
JWT_SECRET=e2e-ci-secret-fixed-value-with-32-chars-min-abc
# TFA TOTP secret 加密密钥（E2E 固定值，≥32 字符）
TFA_ENCRYPTION_KEY=e2e-ci-tfa-encryption-key-with-32-chars-min-abc
NOJ_RUN_E2E=1
# LLM 题平台全局默认（runtime 设置，可在后台热改；env 仅作启动兜底）
# 两项必须同时配置，否则 LLM 题提交返回 400
# NOJ_LLM_DEFAULT_PROVIDER_ID=
# NOJ_LLM_DEFAULT_MODEL=

# ---------- noj-judge ----------
# 单独运行 Rust 集成测试：
#   NOJ_RUN_E2E=1 cargo test --test e2e -- --ignored
# 确保 Docker daemon 在运行中

# ---------- noj-judge 连接 ----------
JUDGE_QUEUE=noj:judge:queue
RESULT_QUEUE=noj:judge:results
JUDGE_RESOURCE_POOLS=ai
JUDGE_AI_TASK_CONCURRENCY=2
WORK_DIR=/tmp/noj-work

# ---------- E2E 测试协调服务（LLM 治理显式屏障）----------
# 两套地址故意分开，不能混用：
# 1) 管理地址只发布在宿主 loopback（端口见上面的 E2E_TEST_COORDINATOR_PORT），
#    测试进程用它创建/观察/释放/删除 gate；
# 2) evaluator 地址必须是评测网络内的服务名（容器内 :8010），写进 evaluator
#    脚本的就是它——写成 localhost 会让评测容器连不上自己。
E2E_TEST_COORDINATOR_URL=http://127.0.0.1:18010
E2E_TEST_COORDINATOR_EVALUATOR_URL=http://noj-e2e-test-coordinator:8010
# LLM Mock 的只读模型记录入口（宿主机视角；CI 由 action 注入同一值）
E2E_LLM_MOCK_INSPECT_URL=http://localhost:8002/

# ---------- 对象存储 ----------
STORAGE_PROVIDER=local

# ---------- 可选 ----------
DATABASE_POOL_MAX=5
# 审计修复：评测镜像/命令白名单与网络开关（E2E 需允许 evaluator 网络能力用例）
JUDGE_IMAGE_PREFIX=noj-
JUDGE_COMMAND_WHITELIST=python3,deno,node,bash,sh
JUDGE_ALLOW_EVALUATOR_NETWORK=true
JUDGE_ALLOW_LOCAL_DOWNLOAD=true
